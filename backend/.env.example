# Copy to .env for local backend run
# cp .env.example .env

DATABASE_URL=postgres://wishlist:wishlist@localhost:5433/wishlist?sslmode=disable
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=local-development-jwt-secret-change-me

# Generate a VAPID pair before testing Web Push. If both are empty,
# the application works normally but push subscription is disabled.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:dev@our-nest.ru

# Alternative split config:
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=wishlist
# DB_PASSWORD=wishlist
# DB_NAME=wishlist
# DB_SSLMODE=disable
